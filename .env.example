# GEMINI_API_KEY: Clé API optionnelle pour les fonctionnalités d'assistance
GEMINI_API_KEY=

# APP_URL: URL publique du site (ex: https://h-justicia.com ou URL Vercel)
APP_URL=https://h-justicia.com

# E-mail administrateur recevant les alertes et requêtes citoyennes (ex: malk'ia@h-justicia.com)
ADMIN_EMAIL=malk'ia@h-justicia.com

# Configuration SMTP (Variables d'environnement à renseigner dans Vercel > Settings > Environment Variables)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=malk'ia@h-justicia.com
SMTP_PASS=
SMTP_FROM="MALK'ia RDC <malk'ia@h-justicia.com>"

