# GEMINI_API_KEY: Clé API optionnelle pour les fonctionnalités d'assistance
GEMINI_API_KEY=

# APP_URL: URL publique du site (ex: https://malkia.cd ou URL Vercel)
APP_URL=

# E-mail administrateur recevant les alertes et requêtes citoyennes
ADMIN_EMAIL=

# Configuration SMTP (Variables d'environnement à renseigner dans Vercel > Settings > Environment Variables)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

